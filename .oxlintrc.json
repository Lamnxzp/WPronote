{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "env": { "node": true, "browser": false },
  "categories": { "correctness": "error" },
  "rules": {
    "no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "warn"
  }
}
